        busca["<b>Servico de Busca</b><br/><i>[Service]</i><br/>Consulta passagens, hospedagens e<br/>atividades por destino, data e filtros"]
        comp["<b>Servico de Comparacao de Custos</b><br/><i>[Service]</i><br/>Consolida as cotacoes por modal e<br/>identifica a opcao mais barata"]
        itin["<b>Servico de Itinerarios</b><br/><i>[Service]</i><br/>Criacao manual, aceite da sugestao da IA<br/>e edicao de dias e itens"]
        social["<b>Servicos Social e de Avaliacoes</b><br/><i>[Service]</i><br/>Convites, reunioes de planejamento,<br/>avaliacoes e moderacao"]
        integ["<b>Servico de Integracao com IA</b><br/><i>[Service + Cache]</i><br/>Monta o payload minimo, registra a chamada<br/>e trata a indisponibilidade"]

        fontes["<b>Fontes de Preco</b><br/><i>[Adaptadores da porta FonteDePreco]</i><br/>Passagem aerea, passagem rodoviaria<br/>e estimativa de carro proprio"]
        prov["<b>Provedores de IA</b><br/><i>[Adaptadores da porta ServicoIA]</i><br/>Simulador local (padrao) e cliente<br/>do provedor externo"]

        repo["<b>Repositorios</b><br/><i>[Spring Data JPA]</i><br/>Acesso as entidades mapeadas com JPA<br/>e consultas JPQL"]
