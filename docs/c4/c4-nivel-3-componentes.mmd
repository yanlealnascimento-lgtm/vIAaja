        ctrl["<b>Controladores REST</b><br/><i>[Spring MVC]</i><br/>Autenticacao, usuarios, busca, destinos, comparador,<br/>assistente, itinerarios, avaliacoes, social,<br/>parceiro e administracao"]
        erros["<b>Tratador de Erros</b><br/><i>[RestControllerAdvice]</i><br/>Converte excecoes de regra de negocio<br/>em respostas padronizadas"]

